<!-- Copy Picker Modal -->
<div class="modal fade" id="copyPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,var(--sage-dark),var(--sage));color:#fff;border:none;padding:.9rem 1.2rem">
                <span class="modal-title" style="font-weight:700;font-size:.97rem">⧉ Sao chép vào bản ghi...</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1rem 1.2rem">
                <p style="font-size:.82rem;color:var(--text-muted);margin-bottom:.75rem">Chọn bản ghi sẽ được ghi đè dữ liệu:</p>
                <div id="copyPickerBody" style="display:flex;flex-direction:column;gap:.45rem;max-height:260px;overflow-y:auto"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #EDF2EF;padding:.75rem 1.2rem">
                <input type="hidden" id="copyPickerSrcId" />
                <button type="button" class="btn-reset" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-filter ms-2" onclick="applyBulkCopy()">⧉ Sao chép</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Reason list from server ──
const reasonList = JSON.parse(document.getElementById('reason-data').textContent || '[]');

function buildReasonOptions(selectedCode) {
    let html = '<option value="">-- Chọn ISS Code --</option>';
    for (const r of reasonList) {
        const sel = r.code === selectedCode ? ' selected' : '';
        html += `<option value="${r.code}"${sel}>${r.code} — ${r.name}</option>`;
    }
    return html;
}

// ── Create Single ──
function openCreateModal() {
    document.getElementById('c_IssCode').innerHTML = buildReasonOptions('');
    new bootstrap.Modal(document.getElementById('createModal')).show();
}

// ── Create Bulk ──
let bulkRowIndex = 0;

function addBulkRow(prefill) {
    const idx = bulkRowIndex++;
    const wrap = document.getElementById('bulkRows');
    const div = document.createElement('div');
    div.className = 'bulk-row';
    div.id = `brow_${idx}`;
    div.innerHTML = `
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="row-num" style="margin-bottom:0">Bản ghi #${idx + 1}</span>
            <div class="d-flex gap-1">
                <button type="button" class="btn-copy-row" onclick="copyBulkRow('brow_${idx}')" title="Sao chép bản ghi này">⧉ Sao chép</button>
                <button type="button" class="btn-remove-row" style="position:static" onclick="removeBulkRow('brow_${idx}')">✕</button>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-md-3 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Mã sự cố</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].Code" placeholder="DT001" value="${prefill?.Code ?? ''}" />
            </div>
            <div class="col-md-5 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Tên sự cố</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].Name" placeholder="Tên sự cố" value="${prefill?.Name ?? ''}" />
            </div>
            <div class="col-md-2 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Trạng thái</label>
                <select class="form-select form-select-sm" name="items[${idx}].State">
                    <option value="">--</option>
                    <option value="Stop" ${prefill?.State === 'Stop' ? 'selected' : ''}>Stop</option>
                    <option value="Run"  ${prefill?.State === 'Run'  ? 'selected' : ''}>Run</option>
                </select>
            </div>
            <div class="col-md-2 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Công đoạn</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].Operation" placeholder="POP" value="${prefill?.Operation ?? ''}" />
            </div>
            <div class="col-md-2 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">TG ước tính</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].EstimateTime" placeholder="30 phút" value="${prefill?.EstimateTime ?? ''}" />
            </div>
            <div class="col-md-4 col-12">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Mô tả</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].Description" placeholder="Mô tả" value="${prefill?.Description ?? ''}" />
            </div>
            <div class="col-md-3 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">Thời gian</label>
                <input type="datetime-local" class="form-control form-control-sm" name="items[${idx}].Datetime" value="${prefill?.Datetime ?? ''}" />
            </div>
            <div class="col-md-2 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">ISS Code</label>
                <select class="form-select form-select-sm" name="items[${idx}].ISS_Code">
                    ${buildReasonOptions(prefill?.ISS_Code ?? '')}
                </select>
            </div>
            <div class="col-md-1 col-6">
                <label class="form-label" style="font-size:.7rem;font-weight:700;text-transform:uppercase;color:#2B6CB0;letter-spacing:.04em">SVN Code</label>
                <input type="text" class="form-control form-control-sm" name="items[${idx}].SVNCode" placeholder="SVN0132" value="${prefill?.SVNCode ?? ''}" />
            </div>
        </div>`;
    wrap.appendChild(div);
    // Scroll to new row
    div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    updateBulkCount();
}

function copyBulkRow(srcId) {
    const row = document.getElementById(srcId);
    if (!row) return;

    // Thu thập data từ row nguồn
    const get = (sel) => row.querySelector(sel)?.value ?? '';
    const data = {
        Code:         get('input[name$="].Code"]'),
        Name:         get('input[name$="].Name"]'),
        State:        get('select[name$="].State"]'),
        Operation:    get('input[name$="].Operation"]'),
        EstimateTime: get('input[name$="].EstimateTime"]'),
        Description:  get('input[name$="].Description"]'),
        Datetime:     get('input[name$="].Datetime"]'),
        ISS_Code:     get('select[name$="].ISS_Code"]'),
        SVNCode:      get('input[name$="].SVNCode"]'),
    };

    // Lấy danh sách tất cả row hiện có (trừ row nguồn)
    const allRows = [...document.querySelectorAll('#bulkRows .bulk-row')];
    const targets = allRows.filter(r => r.id !== srcId);

    if (targets.length === 0) {
        alert('Không có bản ghi nào khác để sao chép vào!');
        return;
    }

    // Build danh sách lựa chọn
    const items = targets.map(r => {
        const label = r.querySelector('input[name$="].Code"]')?.value || '(trống)';
        const num   = r.querySelector('.row-num')?.textContent || r.id;
        return `<label class="copy-target-item">
            <input type="checkbox" value="${r.id}" class="copy-target-cb me-2" />
            <span><strong>${num}</strong> — ${label}</span>
        </label>`;
    }).join('');

    // Hiện picker modal
    document.getElementById('copyPickerBody').innerHTML = items;
    document.getElementById('copyPickerSrcId').value = srcId;
    window._copyData = data;
    new bootstrap.Modal(document.getElementById('copyPickerModal')).show();
}

function applyBulkCopy() {
    const data = window._copyData;
    if (!data) return;
    const checked = [...document.querySelectorAll('.copy-target-cb:checked')];
    if (checked.length === 0) { alert('Hãy chọn ít nhất 1 bản ghi!'); return; }

    checked.forEach(cb => {
        const row = document.getElementById(cb.value);
        if (!row) return;
        const setVal = (sel, val) => { const el = row.querySelector(sel); if (el) el.value = val; };
        setVal('input[name$="].Code"]',         data.Code);
        setVal('input[name$="].Name"]',         data.Name);
        setVal('select[name$="].State"]',        data.State);
        setVal('input[name$="].Operation"]',     data.Operation);
        setVal('input[name$="].EstimateTime"]',  data.EstimateTime);
        setVal('input[name$="].Description"]',   data.Description);
        setVal('input[name$="].Datetime"]',      data.Datetime);
        setVal('select[name$="].ISS_Code"]',     data.ISS_Code);
        setVal('input[name$="].SVNCode"]',       data.SVNCode);

        // Flash highlight
        row.style.transition = 'background .15s';
        row.style.background = '#d1fae5';
        setTimeout(() => row.style.background = '', 800);
    });

    bootstrap.Modal.getInstance(document.getElementById('copyPickerModal')).hide();
}

function removeBulkRow(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
    updateBulkCount();
}

function updateBulkCount() {
    const n = document.querySelectorAll('#bulkRows .bulk-row').length;
    document.getElementById('bulkRowCount').textContent = `${n} bản ghi`;
}

function openCreateBulkModal() {
    // Reset rows
    document.getElementById('bulkRows').innerHTML = '';
    bulkRowIndex = 0;
    addBulkRow(); // Start with 1 row
    new bootstrap.Modal(document.getElementById('createBulkModal')).show();
}

function openEditModal(btn) {
    const d = btn.dataset;
    document.getElementById('e_Id').value           = d.id           ?? '';
    document.getElementById('e_Code').value         = d.code         ?? '';
    document.getElementById('e_Name').value         = d.name         ?? '';
    document.getElementById('e_Operation').value    = d.operation    ?? '';
    document.getElementById('e_EstimateTime').value = d.estimatetime ?? '';
    document.getElementById('e_Description').value  = d.description  ?? '';
    document.getElementById('e_Datetime').value     = d.datetime     ?? '';
    document.getElementById('e_SvnCode').value      = d.svncode      ?? '';

    // ISS Code dropdown
    document.getElementById('e_IssCode').innerHTML = buildReasonOptions(d.isscode ?? '');

    // Set State dropdown (Stop / Run)
    const sel = document.getElementById('e_State');
    for (let i = 0; i < sel.options.length; i++) {
        sel.options[i].selected = (sel.options[i].value === (d.state ?? ''));
    }

    new bootstrap.Modal(document.getElementById('editModal')).show();
}

function openDeleteModal(btn) {
    const d = btn.dataset;
    document.getElementById('del_id').value          = d.id    ?? '';
    document.getElementById('del_label').textContent = `ID #${d.id}  |  ${d.label ?? ''}`;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
}
